{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=veritas;Username=veritas;Password=veritas"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Demo": {
    "SeedData": false
  },
  "Storage": {
    "RootPath": "../../../data/storage"
  },
  "Robots": {
    "UserAgent": "VeritasWorkbench/0.1 (+local-first investigation workspace)",
    "CacheHours": 6
  },
  "Analysis": {
    "RunBackgroundWorker": true,
    "PollSeconds": 5
  },
  "Forensics": {
    "PythonExecutable": "python",
    "WorkerDirectory": "../../../workers/forensics",
    "TimeoutSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
